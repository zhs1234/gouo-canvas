# Account service and server-side gateway. Never use VITE_* for secrets.
GOUO_BACKEND_DEV_TARGET=http://127.0.0.1:3000
GOUO_GATEWAY_BASE_URL=http://127.0.0.1:3000/v1

# Studio business API: npm run dev starts it alongside Vite.
GOUO_STUDIO_PORT=3001
GOUO_STUDIO_DEV_TARGET=http://127.0.0.1:3001

# Server only. Defaults are safe for previews; no paid requests are made.
# With model.channelId, use the base New API key without a channel suffix.
# Each model's channel pin enforces one native upstream attempt.
GOUO_RELAY_API_KEY=
# Required when enabling generation with a personal relay key. Missing owner fails startup.
# Only this New API account can use the key; this is not multi-tenant token provisioning.
# GOUO_RELAY_OWNER_ID=1
GOUO_ENABLE_GENERATION=false
GOUO_ENABLE_IMAGE_JOBS=false
# Same-process durable image jobs; enable only with an approved model/account gateway.
# Accepted/active jobs are bounded; this is not an independent restart worker.
GOUO_MAX_IMAGE_JOBS=2
GOUO_ENABLE_TRIAL=false
GOUO_ENABLE_TOKEN_RENEWAL=false
# Enable only after approved private ingress/token-write/full-model-key verification.
# Copy config/token-renewal.policy.example.json to a private file; its operatorVerified=false deliberately fails startup.
# GOUO_TOKEN_RENEWAL_POLICY_FILE=/absolute/path/to/private-token-renewal-policy.json
# Enable only with approved native one-time finite funding and studio-only edge.
# GOUO_TRIAL_POLICY_FILE=/absolute/path/to/private-trial-policy.json
# Optional paths. Relative paths are resolved from v2/apps/api.
# GOUO_STUDIO_MODELS_FILE=/absolute/path/to/verified-models.json
# GOUO_STUDIO_LEDGER_PATH=/absolute/path/to/studio-requests.sqlite
