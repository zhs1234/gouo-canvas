# docker compose --env-file deploy/.env -f deploy/compose.yml up --build --wait
GOUO_HTTP_PORT=8080
GOUO_PUBLIC_ORIGIN=http://localhost:8080
GOUO_ENABLE_GENERATION=false
GOUO_ENABLE_TRIAL=false
# Prepared trial-edge override only, after native plan/cost/ingress approval.
# GOUO_TRIAL_POLICY_FILE=/run/gouo/trial-policy.json
GOUO_SECURE_COOKIES=false
GOUO_TRUSTED_ORIGIN=
# 用户在 New API 原生页面完成初始化和渠道设置后，再配置账号所属的统一 relay。
# 只挂载用户自己创建的受保护文件，不把真实值写入本示例。
# GOUO_RELAY_OWNER_ID=<New API 账号 ID>
# GOUO_RELAY_API_KEY_FILE=/run/gouo/relay-key
# GOUO_STUDIO_MODELS_FILE=/run/gouo/models.json
# GOUO_RUNTIME_DIR=./runtime

# 可选普通模型路由；先按 docs/v2/MODEL_SETUP.md 核验同一网关的 RetryTimes=0。
# GOUO_RELAY_ROUTING_MODE=model
# GOUO_NORMAL_ROUTING_EVIDENCE_FILE=/run/gouo/normal-routing.evidence.json

# 每用户模式准备：默认不启用，不自定余额/赠额/价格。
# 先批准原生安全/令牌授权，见 docs/v2/USER-BILLING.md。
# GOUO_RELAY_CREDENTIAL_MODE=user-token
# 稳定账号数据库实例 UUID；绑定 Studio 数据卷，关闭试用也必须保留。
# GOUO_ACCOUNT_INSTANCE_ID=<首次配置生成并持久保管的 UUID>
# 启用试用时必须等于 trial-policy.json 的 instanceId；重建账号库须使用新 UUID/业务卷。
# GOUO_USER_TOKEN_QUOTA_CAP=<批准的原生额度单位上限>
# GOUO_USER_TOKEN_LIFETIME_SECONDS=<批准的有效秒数>
# 必须使用上述 model 路由及同网关核验记录，不配共享 key/owner。
