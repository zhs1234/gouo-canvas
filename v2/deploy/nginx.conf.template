map $request_method $unsafe_method {
  default 1;
  GET 0;
  HEAD 0;
  OPTIONS 0;
}
map $http_origin $same_origin {
  default 0;
  "${GOUO_PUBLIC_ORIGIN}" 1;
}
map "$unsafe_method:$same_origin" $reject_origin {
  default 0;
  "1:0" 1;
}
server {
  listen 8080;
  server_name _;
  server_tokens off;
  client_max_body_size 20m;
  # 不记录请求参数、账号标识或任何凭据。
  access_log off;
  add_header X-Content-Type-Options nosniff always;
  add_header Referrer-Policy same-origin always;
  if ($reject_origin) { return 403; }
  location = / { return 302 /studio/; }
  location = /healthz { default_type application/json; return 200 '{"success":true,"service":"gouo-edge"}'; }
  location = /studio { return 301 /studio/; }
  location /studio/ {
    root /usr/share/nginx/html;
    try_files $uri $uri/ /studio/index.html;
    add_header Cache-Control no-cache;
  }
  location ^~ /api/studio/ {
    proxy_pass http://studio-api:3001;
    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_buffering off;
    proxy_cache off;
    proxy_read_timeout 180s;
    proxy_send_timeout 180s;
  }
  # 画布仅通过业务服务调用模型，不能从公开入口绕过其授权边界。
  location = /v1 { return 404; }
  location ^~ /v1/ { return 404; }
  location / {
    proxy_pass http://new-api:3000;
    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_read_timeout 180s;
  }
}
